  "semantics": {
    "null": "SQL NULL. Empty and whitespace-only values remain distinct.",
    "validity": "Non-null values only; empty strings remain eligible.",
    "mandatory": "Non-null only, except name and address which must also be nonblank.",
    "conditional": "Evaluate category only when client_type equals Individual; null category fails.",
    "uniqueness": "All rows sharing a non-null duplicate identifier fail.",
    "whitespace": "Unicode whitespace and separator-only strings are blank.",
    "case_and_trimming": "Case-sensitive; do not trim values before enum or format checks.",
    "length": "Unicode code points, not UTF-8 byte count.",
    "technical_failure": "A job error or missing binding never counts as a data violation."
  },
  "rules": [
    {
      "rule_id": "BR_CLT_001",
      "field": "client_name",
      "title_fr": "Nom renseigné et non blanc",
      "family": "nonblank",
      "dimension": "Completeness",
      "eligible_sql": "1=1",
      "valid_sql": "\"client_name\" IS NOT NULL AND NOT REGEXP_LIKE(\"client_name\", '\\A[\\s\\p{Z}]*\\z')",
      "parameters": {}
    },
    {
      "rule_id": "BR_CLT_002",
      "field": "client_name",
      "title_fr": "Nom de 2 à 100 caractères",
      "family": "length",
      "dimension": "Validity",
      "eligible_sql": "\"client_name\" IS NOT NULL",
      "valid_sql": "CHARACTER_LENGTH(\"client_name\", CODEUNITS32) BETWEEN 2 AND 100",
      "parameters": {
        "min": 2,
        "max": 100
      }
    },
    {
      "rule_id": "BR_CLT_003",
      "field": "client_name",
      "title_fr": "Nom : lettres, espaces, traits d’union et apostrophes",
      "family": "regex",
      "dimension": "Validity",
      "eligible_sql": "\"client_name\" IS NOT NULL",
      "valid_sql": "REGEXP_LIKE(\"client_name\", '\\A[\\p{L} ''\\-]+\\z')",
      "parameters": {
        "pattern": "\\A[\\p{L} '\\-]+\\z",
        "unicode_letters": true
      }
    },
    {
      "rule_id": "BR_CLT_004",
      "field": "client_type",
      "title_fr": "Type de client non nul",
      "family": "required",
      "dimension": "Completeness",
      "eligible_sql": "1=1",
      "valid_sql": "\"client_type\" IS NOT NULL",
      "parameters": {}
    },
    {
      "rule_id": "BR_CLT_005",
      "field": "client_type",
      "title_fr": "Type de client autorisé",
      "family": "allowed_set",
      "dimension": "Validity",
      "eligible_sql": "\"client_type\" IS NOT NULL",
      "valid_sql": "\"client_type\" IN ('Individual', 'Corporate', 'Government', 'Non-Profit')",
      "parameters": {
        "values": [
          "Individual",
          "Corporate",
          "Government",
          "Non-Profit"
        ]
      }
    },
    {
      "rule_id": "BR_CLT_006",
      "field": "client_category",
      "title_fr": "Catégorie non nulle",
      "family": "required",
      "dimension": "Completeness",
      "eligible_sql": "1=1",
      "valid_sql": "\"client_category\" IS NOT NULL",
      "parameters": {}
    },
    {
      "rule_id": "BR_CLT_007",
      "field": "client_category",
      "title_fr": "Catégorie autorisée",
      "family": "allowed_set",
      "dimension": "Validity",
      "eligible_sql": "\"client_category\" IS NOT NULL",
      "valid_sql": "\"client_category\" IN ('Retail', 'SME', 'Enterprise', 'Institutional')",
      "parameters": {
        "values": [
          "Retail",
          "SME",
          "Enterprise",
          "Institutional"
        ]
      }
    },
    {
      "rule_id": "BR_CLT_008",
      "field": "client_category",
      "title_fr": "Un particulier appartient à la catégorie SME",
      "family": "conditional",
      "dimension": "Consistency",
      "eligible_sql": "\"client_type\" = 'Individual'",
      "valid_sql": "\"client_category\" = 'SME'",
      "parameters": {
